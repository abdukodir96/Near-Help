{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/near-help/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/near-help/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/near-help",
  "projects": {
    "near-help": {
      "type": "application",
      "root": "apps/near-help",
      "entryFile": "main",
      "sourceRoot": "apps/near-help/src",
      "compilerOptions": {
        "tsConfigPath": "apps/near-help/tsconfig.app.json"
      }
    },
    "near-help-batch": {
      "type": "application",
      "root": "apps/near-help-batch",
      "entryFile": "main",
      "sourceRoot": "apps/near-help-batch/src",
      "compilerOptions": {
        "tsConfigPath": "apps/near-help-batch/tsconfig.app.json"
      }
    }
  }
}
