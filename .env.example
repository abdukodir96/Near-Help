PORT_API=3007
PORT_BATCH=3008

MONGO_DEV=mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGO_PROD=mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority

JWT_ACCESS_SECRET=replace_with_strong_access_secret
JWT_REFRESH_SECRET=replace_with_strong_refresh_secret
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

UPLOAD_ROOT_DIR=uploads
UPLOAD_IMAGE_DIR=images
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_IMAGE_FILES=10

MAIL_ENABLED=false
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
MAIL_SMTP_USER=replace_with_smtp_username
MAIL_SMTP_PASS=replace_with_smtp_password
MAIL_FROM="NearHelp <no-reply@nearhelp.local>"

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL_PRICING=gpt-5-mini
OPENAI_MODEL_CHAT=gpt-5-mini
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_RETRIES=2
AI_PRICING_ENABLED=true
AI_EMBEDDING_ENABLED=true
AI_RECOMMENDATION_ENABLED=true
AI_SEMANTIC_CANDIDATE_LIMIT=300
AI_LOG_ENABLED=true
